{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Faderust",
  "Version": "0.3.7.0",
  "Author": "Niklas970",
  "Description": "Steuert den Faderust-Mixer: Fader, Stummschalten, Presets und Windows-Standardgeräte.",
  "URL": "https://github.com/Niklas970/faderust",
  "UUID": "com.niklas970.faderust",
  "Category": "Faderust",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/icon",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "Actions": [
    {
      "Name": "Streifen",
      "UUID": "com.niklas970.faderust.strip",
      "Icon": "imgs/actions/strip/icon",
      "Tooltip": "Streifen wie im Pult: Pegel für alle Ausgänge des Eingangs, Drücken schaltet MUTE.",
      "PropertyInspectorPath": "ui/strip.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "Icon": "imgs/actions/strip/icon",
        "TriggerDescription": {
          "Rotate": "Pegel",
          "Push": "MUTE",
          "Touch": "MUTE"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/strip/key",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "Name": "Master",
      "UUID": "com.niklas970.faderust.master",
      "Icon": "imgs/actions/master/icon",
      "Tooltip": "Master-Fader eines Ausgangs, Drücken schaltet ihn stumm.",
      "PropertyInspectorPath": "ui/master.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "Icon": "imgs/actions/master/icon",
        "TriggerDescription": {
          "Rotate": "Pegel",
          "Push": "Stumm",
          "Touch": "Stumm"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/master/key",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "Name": "Fader",
      "UUID": "com.niklas970.faderust.volume",
      "Icon": "imgs/actions/volume/icon",
      "Tooltip": "Regler: Pegel ändern, drücken schaltet stumm. Taste: Pegel um einen Schritt ändern.",
      "PropertyInspectorPath": "ui/volume.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "Icon": "imgs/actions/volume/icon",
        "TriggerDescription": {
          "Rotate": "Pegel",
          "Push": "Stumm",
          "Touch": "Stumm"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/volume/key",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "Name": "Stumm",
      "UUID": "com.niklas970.faderust.mute",
      "Icon": "imgs/actions/mute/icon",
      "Tooltip": "Schaltet einen Eingang auf einem oder allen Ausgängen stumm.",
      "PropertyInspectorPath": "ui/mute.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/actions/mute/on",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/mute/off",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Preset laden",
      "UUID": "com.niklas970.faderust.preset",
      "Icon": "imgs/actions/preset/icon",
      "Tooltip": "Lädt ein gespeichertes Preset. Leuchtet, solange die Fader dazu passen.",
      "PropertyInspectorPath": "ui/preset.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/actions/preset/key",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/preset/active",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Standardgerät",
      "UUID": "com.niklas970.faderust.device",
      "Icon": "imgs/actions/device/icon",
      "Tooltip": "Macht ein Gerät zum Windows-Standard (Wiedergabe oder Aufnahme).",
      "PropertyInspectorPath": "ui/device.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/actions/device/key",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/device/active",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Alles stumm",
      "UUID": "com.niklas970.faderust.panic",
      "Icon": "imgs/actions/mute/icon",
      "Tooltip": "Schaltet alle Ausgänge stumm oder wieder ein. Leuchtet, solange alle stumm sind.",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/actions/mute/on",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/mute/off",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Pegel setzen",
      "UUID": "com.niklas970.faderust.level",
      "Icon": "imgs/actions/volume/icon",
      "Tooltip": "Setzt einen Fader auf einen festen Pegel: Streifen, ein Ausgang oder ein Master.",
      "PropertyInspectorPath": "ui/level.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/level/key",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "Name": "Lauter / Leiser",
      "UUID": "com.niklas970.faderust.group",
      "Icon": "imgs/actions/volume/icon",
      "Tooltip": "Ändert mehrere Streifen und Master gemeinsam: lauter (positiver Schritt) oder leiser (negativ).",
      "PropertyInspectorPath": "ui/group.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/group/up",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "Name": "Auswählen",
      "UUID": "com.niklas970.faderust.select",
      "Icon": "imgs/actions/strip/icon",
      "Tooltip": "Wählt einen Streifen oder Master aus (leuchtet). „Lauter / Leiser“ mit „Auswahl verwenden“ bewegt dann die Auswahl.",
      "PropertyInspectorPath": "ui/select.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/actions/select/key",
          "TitleAlignment": "bottom",
          "FontSize": 11
        },
        {
          "Image": "imgs/actions/select/on",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "Name": "Faderust-Seite",
      "UUID": "com.niklas970.faderust.page",
      "Icon": "imgs/actions/preset/icon",
      "Tooltip": "Öffnet die Faderust-Seite mit den wichtigen Tasten (Stream Deck mit 15 Tasten).",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/page/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Zurück",
      "UUID": "com.niklas970.faderust.back",
      "Icon": "imgs/actions/preset/icon",
      "Tooltip": "Zurück zum vorherigen Profil (für die Faderust-Seite).",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/back/key",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ],
  "Profiles": [
    {
      "Name": "Faderust",
      "DeviceType": 0,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    }
  ]
}
